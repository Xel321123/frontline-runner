{
  "name": "frontline-runner",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Frontline Runner — an offline-first landscape tug-of-war battlefield (Vite + TypeScript + Canvas 2D, 100% procedural graphics), portable to iOS/Android via Capacitor.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "check:data": "node scripts/check-campaign-data.mjs",
    "check:sim": "node scripts/simulate-match.mjs",
    "check:save": "node scripts/check-progression.mjs",
    "check:viewport": "node scripts/check-viewport.mjs",
    "build": "tsc && vite build && node scripts/copy-404.mjs",
    "build:native": "VITE_BASE=./ npm run build",
    "preview": "vite preview --port 4173",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
